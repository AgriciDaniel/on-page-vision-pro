# Copy to .env.local (or .env) and set your server-side Gemini API key.
# The app boots and serves capture/health endpoints without a key; AI audit routes require it.
GEMINI_API_KEY=

# Bind address for Express (defaults to 127.0.0.1; set to 0.0.0.0 on container hosts like Cloud Run or AI Studio).
# HOST=127.0.0.1

# Access token protecting all /api/* routes except /api/health and /api/session (Bearer header or /api/session cookie; use >= 16 chars).
# Optional on loopback; required when HOST is not loopback unless ALLOW_OPEN=1.
# APP_ACCESS_TOKEN=

# Set to 1 to allow starting on a non-loopback HOST without APP_ACCESS_TOKEN (not recommended on public networks).
# ALLOW_OPEN=1

# Per-IP fixed-window rate limits (requests per minute; always on in memory, returns HTTP 429 with Retry-After).
# RATE_LIMIT_PER_MIN=300
# RATE_LIMIT_MODEL_PER_MIN=20
# RATE_LIMIT_AUTH_PER_MIN=10

# Primary multimodal model for viewport, deep-scan, element, compare, and copy-variant audits.
# GEMINI_MODEL_AUDIT=gemini-4-neon

# Fallback model used when the primary audit model fails with a retryable status or unusable JSON.
# GEMINI_MODEL_AUDIT_FALLBACK=gemini-4-hydrogen

# Fast text model for code fixes, SERP research, strategist chat, and audio brief scripting.
# GEMINI_MODEL_TEXT=gemini-4-hydrogen

# Image generation model for full-hero visual redesigns (2K).
# GEMINI_MODEL_IMAGE_HERO=gemini-nano-banana-2.1

# Image editing model for element redesigns (1K; defaults to Nano Banana 2.1 with Lite fallback).
# GEMINI_MODEL_IMAGE_EDIT=gemini-nano-banana-2.1
# GEMINI_MODEL_IMAGE_EDIT_FALLBACK=gemini-3.1-flash-lite-image

# Text-to-speech model for spoken executive audio briefings.
# GEMINI_MODEL_TTS=gemini-3.8-flash-lite-tts

# Full-page audit thinking level: low, medium, high, or xhigh (default: low).
# GEMINI_PAGE_AUDIT_THINKING=low

# Full-page audit section height in image pixels: whole number 900 to 4000 (defaults: 1800 desktop, 2400 mobile).
# GEMINI_PAGE_SECTION_HEIGHT_DESKTOP=1800
# GEMINI_PAGE_SECTION_HEIGHT_MOBILE=2400

# Process-wide full-page audit calls in flight across all audits: whole number 1 to 16 (default: 8).
# GEMINI_PAGE_AUDIT_CONCURRENCY=8

# Same-model retries on HTTP 429 / RESOURCE_EXHAUSTED before falling back: whole number 0 to 5 (default: 2).
# GEMINI_RATE_LIMIT_RETRIES=2

# Hard cap on model API requests per server process (returns HTTP 429 past it; unset = no limit; non-integer fails closed).
# VP_MODEL_CALL_BUDGET=12

# Debug only: save raw model answers under .agent/results/raw-model-text/ before parsing and cleanup (off by default).
# VP_DEBUG_RAW=1
